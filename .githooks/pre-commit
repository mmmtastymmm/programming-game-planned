#!/usr/bin/env bash
# Fast doc gate: runs the mermaid check before every commit that touches a .md.
#
# Install (one command, per clone):   scripts/install-hooks.sh
# Skip once:                          git commit --no-verify
#
# It checks the STAGED content, not the working tree — it extracts the index to
# a temp dir and runs there. So a half-staged fix can't pass on the strength of
# unstaged edits, and unstaged breakage can't block a clean commit.
#
# Only the docs half of CI runs here (seconds). The Rust half is too slow for a
# commit hook; CI covers it.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Nothing markdown staged → nothing to check.
if ! git diff --cached --quiet --name-only --diff-filter=ACMR -- '*.md' 2>/dev/null; then
  :
else
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found, skipping the mermaid check (CI still gates it)" >&2
  exit 0
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# Materialize every tracked .md as staged, preserving paths.
git ls-files -z -- '*.md' | git checkout-index --stdin -z --prefix="$TMP/"

if [ ! -d "$TMP/docs" ]; then
  exit 0
fi

if ! scripts/ci.sh docs "$TMP"; then
  echo >&2
  echo "pre-commit: mermaid check failed on the STAGED content — commit aborted." >&2
  echo "            fix the diagram, or 'git commit --no-verify' to bypass." >&2
  exit 1
fi
